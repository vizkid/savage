{
  "manifest_version": 3,
  "name": "SaVaGe",
  "version": "1.0.0",
  "description": "Convert SVGs to PNGs for Google Slides — copy or drag SVGs in and they arrive as high-res transparent PNGs.",
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SaVaGe settings"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["config.js", "rasterize.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
