{
  "manifest_version": 3,
  "name": "Savage",
  "version": "2.0.0",
  "description": "Paste SVGs into Google Slides as native, editable shapes. Copy or drag one in — it lands recolorable and scalable, or PNG.",
  "permissions": ["clipboardRead", "clipboardWrite", "storage", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["<all_urls>"],
  "homepage_url": "https://github.com/vizkid/savage",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Savage settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*"],
      "js": ["config.js", "rasterize.js", "pathdata.js", "vendor/opentype.min.js", "vendor/clipper.js", "vendor/roboto-regular.js", "fonts.js", "vector-template.js", "vectorize.js", "content.js", "iframe-paste.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
